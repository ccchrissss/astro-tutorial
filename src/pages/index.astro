---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Journal of Surfing";
---

<BaseLayout pageTitle={pageTitle}>
	<h2 class="text" slot="additional-content">Reports from surf spots around the world!</h2>
	<h4 class="text">New Jersey > The North Shore > Great Lakes > Gold Coast
	</h4>

	<style>
		h2 {
			color: blue;
		}
		.text {
			margin: 4rem 0;
		}
	</style>
</BaseLayout>